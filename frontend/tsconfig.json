{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@services/*": ["./bindings/paradox-modding-tools/services/*"],
      "@assets/*": ["./src/assets/*"]
    }
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*", "aria-*"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "bindings/**/*.ts",
    "auto-imports.d.ts",
    "components.d.ts"
  ]
}
