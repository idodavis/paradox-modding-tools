{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "node scripts/check.mjs --noEmit",
    "lint": "node scripts/eslint.mjs src && prettier --check src",
    "format": "prettier --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@nuxt/ui": "^4.11.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@pinia/colada": "^1.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@wailsio/runtime": "^3.0.0-beta.14",
    "colorjs.io": "^0.7.1",
    "monaco-editor": "0.57.0",
    "pinia": "^4.0.3",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "tsc-js": "npm:typescript@6.0.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "typescript": "$typescript"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.28.2": true
  }
}
