  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "tsc-js": "npm:typescript@6.0.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
